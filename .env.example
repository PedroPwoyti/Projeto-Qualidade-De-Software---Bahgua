# Porta na qual o servidor HTTP será executado
PORT=3000

# Chave secreta para assinatura dos tokens JWT (OBRIGATÓRIA)
# Deve ser uma sequência segura, longa e aleatória (mínimo de 32 caracteres)
JWT_SECRET=exemplo_segredo_jwt_longo_e_seguro_minimo_32_caracteres_dev

# Credenciais para criação automática do administrador inicial (opcionais em desenvolvimento)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@bahgua.com
ADMIN_SENHA=admin123
